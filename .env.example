# App
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@trendaura.pk

# Database (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trendaura_db

# Groq (LLM Inference - Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Gemini (Vision & Embeddings - Free Tier)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_VISION=gemini-1.5-flash
GEMINI_MODEL_EMBED=text-embedding-004

# Search API (Pricing Auditor Agent)
TAVILY_API_KEY=your_tavily_api_key_here

# Cloudinary (Product Media Storage)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Business Rules & Agent Thresholds
REFUND_AUTO_APPROVE_LIMIT=5000
FRAUD_FLAG_THRESHOLD=50

# Custom Payment Details (Bank Transfer)
BANK_NAME=Meezan Bank / Standard Chartered
BANK_ACCOUNT_TITLE=TrendAura Official Retail Ltd
BANK_ACCOUNT_NUMBER=010293847501
BANK_IBAN=PK36SCBL00000010293847501
